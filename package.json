    "api:setup": "npm --prefix workers/api ci && node -e \"const f=require('fs');const p='workers/api/.dev.vars';if(!f.existsSync(p))f.copyFileSync('workers/api/.dev.vars.example',p)\"",
    "api:mock-paypal": "python3 scripts/mock-paypal.py",
